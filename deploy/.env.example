# ─────────────────────────────────────────────────────────────────────────────
#  Configuración de JARVIS_OS
#  Copia este fichero a  .env  en la raíz del proyecto y rellena tus valores.
#  NUNCA subas el .env real al repositorio (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Cerebro (elige UN proveedor) ────────────────────────────────────────────
# "openai_responses" = OpenAI nativo · "anthropic" = Claude
# "openai" = compatible (NVIDIA NIM, Ollama...)
JARVIS_LLM_PROVIDER=anthropic

# --- Opción A: Anthropic (Claude) ---
ANTHROPIC_API_KEY=pon-tu-api-key-aqui
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=high

# --- Opción B: NVIDIA NIM (compatible con OpenAI) ---
# Para usar NVIDIA: pon JARVIS_LLM_PROVIDER=openai y descomenta lo siguiente.
# Obtén la API key y el nombre EXACTO del modelo en build.nvidia.com (botón
# "Get API Key" / "View Code"). Ejemplo con GLM-5.2 de Z.ai:
#   https://build.nvidia.com/z-ai/glm-5.2
# JARVIS_LLM_PROVIDER=openai
# JARVIS_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# JARVIS_OPENAI_API_KEY=nvapi-...
# JARVIS_OPENAI_MODEL=z-ai/glm-5.2   # copia el id exacto del ejemplo de código de la página
# Mantén false para que Nemotron no exponga razonamiento interno en el HUD.
JARVIS_OPENAI_ENABLE_THINKING=false

# --- Opción C: OpenAI Responses API (modo económico local-first) ---
# El micrófono, Hey JARVIS, detección de silencio, STT y TTS permanecen locales.
# OpenAI recibe solamente el texto final después de una activación válida.
# JARVIS_LLM_PROVIDER=openai_responses
# OPENAI_API_KEY=sk-...
# JARVIS_OPENAI_RESPONSES_MODEL=gpt-5.4-nano
# JARVIS_OPENAI_RESPONSES_EFFORT=low
# JARVIS_OPENAI_RESPONSES_VERBOSITY=low
# Limita respuestas normales para evitar consumo accidental.
# JARVIS_OPENAI_RESPONSES_MAX_TOKENS=900
# Tope diario combinado de entrada + salida. 0 desactiva el límite.
# JARVIS_OPENAI_DAILY_TOKEN_LIMIT=100000
# En Docker se fuerza al volumen persistente /app/data.
# JARVIS_OPENAI_USAGE_DB=data/openai_usage.db
# Reduce el historial enviado solo a OpenAI; la memoria larga sigue siendo local.
# JARVIS_OPENAI_HISTORY_ITEMS=24

# --- Voz OpenAI Realtime bajo demanda ---
# Usa la misma OPENAI_API_KEY. El micrófono y STT permanecen locales; solo se envía
# el texto de la respuesta para sintetizar voz. Kokoro continúa como respaldo.
# JARVIS_OPENAI_REALTIME_ENABLED=true
# JARVIS_OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# JARVIS_OPENAI_REALTIME_VOICE=marin
# JARVIS_OPENAI_REALTIME_MAX_OUTPUT_TOKENS=700
# Cada conexión expira rápidamente y existe un tope diario persistente.
# JARVIS_OPENAI_REALTIME_SESSION_SECONDS=45
# JARVIS_OPENAI_REALTIME_DAILY_SESSIONS=50

# --- Conversación Realtime completa (Realtime como cerebro, no solo como voz) ---
# Con esto activo, tras «Hey JARVIS» el audio va al gateway y de ahí a Realtime,
# que responde y **ejecuta herramientas** con las mismas aprobaciones que por texto.
# La sesión se abre solo tras la activación local: en reposo no se envía nada.
# JARVIS_REALTIME_CONVERSATION_ENABLED=true
# Sensibilidad del VAD de OpenAI que cierra tu turno.
# JARVIS_REALTIME_VAD_THRESHOLD=0.5
# JARVIS_REALTIME_SILENCE_MS=600
# JARVIS_REALTIME_SPEED=1.0
# Recorte del resultado de una herramienta antes de dárselo al modelo.
# JARVIS_REALTIME_MAX_TOOL_OUTPUT=4000
# Inactividad antes de cerrar. Conviene holgado: la entrada de audio cacheada
# cuesta 33 veces menos, así que una pregunta de seguimiento dentro de la
# ventana sale mucho más barata que reabrir la sesión con la caché fría.
# JARVIS_REALTIME_IDLE_SECONDS=90
# JARVIS_REALTIME_MAX_SESSIONS=2
# Techo de gasto diario en USD. Contar sesiones no mide dinero: una larga cuesta
# lo que muchas cortas. Al alcanzarlo, la conversación termina y JARVIS sigue
# funcionando con la voz local. 0 desactiva el límite.
# JARVIS_REALTIME_DAILY_BUDGET_USD=1.0
# Tarifas por millón de tokens (gpt-realtime-2.1-mini). Ajústalas si cambian:
# están aquí y no en el código para que no se queden obsoletas en silencio.
# JARVIS_REALTIME_PRICE_AUDIO_IN=10.0
# JARVIS_REALTIME_PRICE_AUDIO_CACHED=0.30
# JARVIS_REALTIME_PRICE_AUDIO_OUT=20.0
# JARVIS_REALTIME_PRICE_TEXT_IN=0.60
# JARVIS_REALTIME_PRICE_TEXT_OUT=2.40

# --- Opción D: Ollama (modelos locales, offline/privacidad) ---
# JARVIS_LLM_PROVIDER=openai
# JARVIS_OPENAI_BASE_URL=http://localhost:11434/v1
# JARVIS_OPENAI_API_KEY=ollama
# JARVIS_OPENAI_MODEL=llama3.1

JARVIS_MAX_TOKENS=16000

# ─── Zona horaria ────────────────────────────────────────────────────────────
# Sin esto el contenedor vive en UTC y «recuérdame a las 8» suena a las 10 en
# España. Las dos deben coincidir: TZ es el reloj del sistema dentro del
# contenedor y JARVIS_TIMEZONE es la que usa el agente para interpretar horas.
# Lista de nombres válidos: America/Bogota, America/Mexico_City, Europe/Madrid…
TZ=Europe/Madrid
JARVIS_TIMEZONE=Europe/Madrid

# ─── Personalidad ────────────────────────────────────────────────────────────
JARVIS_PERSONA_NAME=JARVIS
JARVIS_LANGUAGE=es
# Valor inicial de las reglas de la casa. Se pueden cambiar en caliente sin
# reiniciar: PUT /persona con {"overlay": "..."} y la clave del gateway.
# JARVIS_PERSONA_EXTRA=Trátame de usted. No ejecutes nada destructivo sin confirmar.

# ─── Memoria interna (propia de JARVIS, independiente del proveedor) ──────────
JARVIS_MEMORY_DB=data/jarvis_memory.db
# Hechos que se le ponen delante al modelo en cada turno. Sin esto, JARVIS solo
# recuerda algo si decide consultar la memoria por su cuenta, y lo normal es que
# no lo haga. Van en la capa volátil del prompt, así que no rompen la caché.
# 0 desactiva la inyección y vuelve al comportamiento anterior.
JARVIS_MEMORY_FACTS_IN_PROMPT=12

# --- Memoria semántica (búsqueda por significado) ---
# Sin esto, la memoria busca por coincidencia de texto: «mi coche es un Tesla»
# no se encuentra al preguntar por «el vehículo». Con embeddings, sí.
#   auto   = modelo local si está instalado; si no, el endpoint compatible.
#   local  = solo local. Nada sale de tu red (recomendado: es tu vida privada).
#   openai = usa JARVIS_OPENAI_BASE_URL y su clave. NVIDIA NIM sirve embeddings,
#            así que no descarga ni consume CPU del servidor, pero los hechos
#            salen de casa para convertirse en vectores.
#   off    = desactivado, se busca por texto como antes.
JARVIS_EMBEDDINGS=auto
# Local: multilingüe a propósito, los modelos solo-inglés fallan en español.
# Es una capa fina sobre el torch que Kokoro ya trae; instálalo con:
#   pip install 'jarvis-core[memory]'
# JARVIS_EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Remoto (NVIDIA NIM y compatibles).
# JARVIS_EMBEDDINGS_REMOTE_MODEL=nvidia/nv-embedqa-e5-v5
# Por debajo de esto, dos hechos no se parecen lo bastante para ocupar prompt.
# JARVIS_EMBEDDINGS_MIN_SIMILARITY=0.35
# En Docker se fuerza a /app/data/jarvis_goals.db dentro del volumen persistente.
# JARVIS_GOALS_DB=data/jarvis_goals.db

# ─── Agenda ──────────────────────────────────────────────────────────────────
# Almacén local, como las tareas. La diferencia: una tarea es algo que JARVIS
# ejecuta a una hora; un evento es algo que ocurre y sobre lo que te informa.
# En Docker se fuerza al volumen persistente.
# JARVIS_CALENDAR_DB=data/jarvis_calendar.db

# ─── Modo offline ────────────────────────────────────────────────────────────
# Garantiza que NADA sale de tu red. No significa «sin red»: Home Assistant,
# Navidrome, un n8n autoalojado o un Ollama en otra máquina siguen funcionando,
# igual que Whisper, Kokoro y «Hey JARVIS», que ya eran locales.
#
# Al activarlo se apagan solos la voz de OpenAI Realtime, la búsqueda y lectura
# web, y los embeddings remotos. Lo que no se puede apagar sin más —el proveedor
# de LLM— se reporta en /ready, que dirá "offline": true solo si de verdad se
# está cumpliendo. Para cumplirlo del todo necesitas un modelo local:
#   JARVIS_LLM_PROVIDER=openai
#   JARVIS_OPENAI_BASE_URL=http://IP-DE-OLLAMA:11434/v1
JARVIS_OFFLINE=false
# Nombres de tu LAN que no se reconocen como internos por su forma (un dominio
# propio apuntando a una IP privada). Todo lo que no se demuestre interno se
# considera externo, así que decláralos aquí.
# JARVIS_OFFLINE_ALLOWED_HOSTS=nas.midominio.com,ollama.midominio.com

# ─── Herramientas ────────────────────────────────────────────────────────────
JARVIS_ENABLE_SHELL=true
# Lista blanca de comandos permitidos para la herramienta de shell (separados por comas).
JARVIS_SHELL_ALLOWLIST=echo,ls,cat,date,uptime,whoami,hostname,df,free,uname,pwd,ps
JARVIS_MAX_TOOL_ITERATIONS=12
# Subagentes especializados (casa, investigación, código, agenda). Cada uno ve
# solo sus herramientas, así que arrastra menos contexto y se equivoca menos.
# Solo se ofrecen los que de verdad tienen herramientas registradas: sin
# conectores, el de casa no aparece. Las aprobaciones se heredan: una acción
# sensible dentro de un subagente sigue pidiendo permiso en el HUD.
JARVIS_SUBAGENTS=true
# Tope por llamada al proveedor. Sin él, un modelo que se atasca deja el HUD
# bloqueado: sin teclado, sin cerrar la conversación y sin voz.
JARVIS_LLM_TIMEOUT=120
# Tope de lo que se le devuelve al modelo por resultado de herramienta. Un
# inventario entero se queda en el historial y vuelve a viajar en cada vuelta
# del bucle de herramientas, haciendo cada iteración más lenta que la anterior.
JARVIS_MAX_TOOL_OUTPUT=8000
JARVIS_MAX_HISTORY_ITEMS=80

# ─── Gateway (servicio en red) ───────────────────────────────────────────────
# 0.0.0.0 = accesible desde otros equipos de la red local.
JARVIS_GATEWAY_HOST=0.0.0.0
JARVIS_GATEWAY_PORT=8080
# Obligatoria. Genera una clave larga y aleatoria antes de arrancar el gateway.
# REST: cabecera X-Jarvis-Key. WebSocket/HUB: ?token=<clave>.
JARVIS_GATEWAY_API_KEY=
JARVIS_GATEWAY_MAX_MESSAGE_CHARS=16000
JARVIS_GATEWAY_MAX_SESSIONS=100
# Orígenes desde los que se sirve el HUD web (separados por comas).
JARVIS_GATEWAY_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173

# ─── Voz local ───────────────────────────────────────────────────────────────
JARVIS_VOICE_ENABLED=true

# --- Reconocimiento (STT) ---
# `small` equilibra precisión en español y velocidad para CPU. El primer uso lo descarga.
JARVIS_STT_MODEL=small
JARVIS_STT_DEVICE=cpu
JARVIS_STT_COMPUTE_TYPE=int8
# JARVIS_STT_DOWNLOAD_ROOT=/app/data/models

# --- Síntesis (TTS) ---
# Kokoro necesita el binario del sistema `espeak-ng` (el Dockerfile ya lo instala;
# en Ubuntu directo:  sudo apt install espeak-ng).
# Voces en español: ef_dora (femenina) · em_alex, em_santa (masculinas).
JARVIS_TTS_VOICE=em_alex
# 'e' = español. Kokoro descarga sus pesos (~330 MB) en el primer uso.
JARVIS_TTS_LANG_CODE=e
# Velocidad del habla (1.0 = normal; 0.9 más pausado, 1.1 más ágil).
JARVIS_TTS_SPEED=1.0

# --- Palabra de activación «Hey JARVIS» (openWakeWord, 100% local) ---
# Es la única etapa que escucha de forma permanente, y corre entera en tu servidor:
# ni sale audio de reposo a ningún tercero ni consume presupuesto de OpenAI.
JARVIS_WAKEWORD_ENABLED=true
JARVIS_WAKEWORD_MODEL=hey_jarvis
# Ajusta con:  jarvis wake-test grabacion.wav
# Baja a ~0.35 si no te reconoce; sube a ~0.65 si se activa solo.
JARVIS_WAKEWORD_THRESHOLD=0.5
# VAD de Silero previo al detector. 0 lo desactiva; ~0.3 ayuda con televisión
# o música de fondo, a costa de algo más de CPU.
JARVIS_WAKEWORD_VAD_THRESHOLD=0
# Segundos que ignora tras activar, para que una frase no dispare dos veces.
JARVIS_WAKEWORD_REFRACTORY_SECONDS=2
# Escuchas simultáneas (HUD + puntos ESP32). Cada una carga su propio detector.
JARVIS_WAKEWORD_MAX_STREAMS=8

# ─── Control agéntico ────────────────────────────────────────────────────────
# Los archivos quedan confinados al volumen /app/workspace; no se expone el host completo.
JARVIS_AGENT_CONTROL_ENABLED=true
JARVIS_WORKSPACE_MAX_FILE_BYTES=262144
# Cada actualización de un archivo existente o instalación pide aprobación en el HUD.
JARVIS_APPROVAL_TIMEOUT_SECONDS=120
JARVIS_PACKAGE_INSTALL_ENABLED=true
# Docker permite pip persistente en /app/.local. Para apt usa el despliegue systemd y
# configura una regla sudo mínima para el usuario jarvis.
JARVIS_PACKAGE_INSTALL_MANAGERS=pip
# Ejecuta únicamente archivos .py del workspace, siempre con aprobación en el HUD.
JARVIS_PYTHON_EXECUTION_ENABLED=true
JARVIS_PYTHON_EXECUTION_TIMEOUT_SECONDS=60

# ─── Internet público de solo lectura ───────────────────────────────────────
JARVIS_INTERNET_ACCESS_ENABLED=true
JARVIS_WEB_REQUEST_TIMEOUT_SECONDS=15
JARVIS_WEB_MAX_DOWNLOAD_BYTES=1048576
# Opcional y recomendado para búsquedas más fiables. Sin clave usa Bing RSS.
# JARVIS_BRAVE_SEARCH_API_KEY=
JARVIS_HUD_WORKSPACE_ENABLED=true
# Con el HUD encendido, JARVIS dispone además de `open_viewer`: abre ventanas
# flotantes para MIRAR una imagen, un PDF, un documento del workspace, un vídeo
# de YouTube o una página. Se arrastran y conviven con el pizarrón. No hay nada
# más que configurar.

# ─── Dónde estás (para rutas, tiempos de viaje y avisos con contexto) ────────
# La buena es Home Assistant: la app Companion publica la posición del móvil en
# `person.<tú>` o `device_tracker.<móvil>`. JARVIS la lee por el conector de HA
# que ya tienes; solo hace falta que el módulo declare `homeassistant.state`
# entre sus acciones de LECTURA, porque el listado de entidades no trae las
# coordenadas —solo id, nombre y estado—.
# Vacío = JARVIS busca solo entre las entidades person/device_tracker.
# JARVIS_LOCATION_ENTITY=person.carlos
#
# Respaldo para cuando Home Assistant no dé nada. NO es «dónde estás»: es una
# dirección fija, y JARVIS lo dice al usarla en vez de hacerla pasar por tu
# posición. Aun así suele ser el origen correcto para «cómo llego a X».
# JARVIS_HOME_LAT=40.4168
# JARVIS_HOME_LON=-3.7038
# JARVIS_HOME_LABEL=Casa
#
# Por IP no se hace, a propósito: dentro de la red el gateway solo ve una
# dirección privada, y desde fuera sale el punto de salida de tu operador, que
# puede estar a decenas de kilómetros. Además habría que mandársela a un tercero.

# ─── Navegador que JARVIS conduce ────────────────────────────────────────────
# Un Chromium de verdad, paso a paso: busca, pulsa un resultado, lee, vuelve.
# Sirve para lo que `fetch_web_page` no puede: páginas que se montan con
# JavaScript, formularios, resultados que hay que ir abriendo. Y se ve en una
# ventana del HUD, donde tú también puedes pinchar sobre la misma pestaña.
#
# Apagado por defecto y en dos pasos, porque Chromium añade ~700 MB a la imagen:
#   1) INSTALL_BROWSER=true en este .env y reconstruye (docker compose build).
#   2) JARVIS_BROWSER_ENABLED=true aquí.
# Necesita también JARVIS_INTERNET_ACCESS_ENABLED=true, y el modo offline lo
# apaga siempre.
# INSTALL_BROWSER=true
JARVIS_BROWSER_ENABLED=false
JARVIS_BROWSER_TIMEOUT_SECONDS=25
# Cuánto texto de la página vuelve al modelo en cada paso.
JARVIS_BROWSER_MAX_TEXT_CHARS=6000

# ─── Conectores externos mediante n8n ───────────────────────────────────────
# n8n conserva las credenciales OAuth de Gmail, Outlook, WhatsApp, etc. JARVIS
# llama únicamente un webhook autenticado y solo las acciones declaradas aquí.
JARVIS_CONNECTORS_ENABLED=false
# Registro modular cifrado. Genera una clave y no la cambies mientras existan módulos:
# openssl rand -hex 32
# JARVIS_CONNECTOR_MASTER_KEY=
# JARVIS_CONNECTOR_DB=/app/data/jarvis_connectors.db
# JARVIS_PROACTIVE_EVENTS_DB=/app/data/jarvis_proactive_events.db
# JARVIS_MCP_DB=/app/data/jarvis_mcp.db
# JARVIS_SKILLS_DB=/app/data/jarvis_skills.db
# Habilidades aprendidas de tipo 'python': código que JARVIS escribe y luego
# ejecuta. Se corre en un proceso aparte, con entorno recortado y tiempo
# límite, y pide confirmación; aun así queda apagado salvo que lo pidas.
JARVIS_SKILLS_PYTHON_ENABLED=false
# La conversación entrante está apagada hasta autorizar hashes de usuarios concretos.
JARVIS_CONNECTOR_CHAT_ENABLED=false
# JARVIS_CONNECTOR_ALLOWED_USER_HASHES=
# JARVIS_N8N_WEBHOOK_URL=https://n8n.example.com/webhook/jarvis-connector
# Genera con: openssl rand -hex 32
# JARVIS_N8N_WEBHOOK_TOKEN=
# Acciones de lectura: se ejecutan sin confirmación. Declara solo nodos ya creados en n8n.
# JARVIS_N8N_READ_ACTIONS=gmail.search,gmail.read,outlook.search,outlook.calendar.list,whatsapp.unread,homeassistant.state,homeassistant.history,alexa.devices
# Acciones de escritura: siempre muestran APROBAR / DENEGAR en el HUD.
# JARVIS_N8N_WRITE_ACTIONS=gmail.send,gmail.reply,outlook.send,outlook.calendar.create,whatsapp.send,homeassistant.service,homeassistant.scene,alexa.routine
# Los conectores no viven solo en este fichero: desde el panel ⚡ CONECTORES del
# HUD puedes registrar módulos de tipo `http`, que hablan directamente con
# cualquier API de tu red (Proxmox, un NAS, un router...) sin pasar por n8n y
# sin escribir código nuevo. Se declaran la URL base, la cabecera de
# autenticación y las rutas exactas permitidas, en la forma `GET /api2/json/nodes`,
# separando lectura de escritura: la escritura siempre pide APROBAR / DENEGAR.
# El agente solo puede llamar rutas de esa lista; no puede inventarse una.
JARVIS_CONNECTOR_TIMEOUT_SECONDS=20
JARVIS_CONNECTOR_MAX_PAYLOAD_BYTES=65536
JARVIS_CONNECTOR_MAX_RESPONSE_BYTES=262144

# ─── Correo saliente (SMTP) ──────────────────────────────────────────────────
# Con esto configurado, JARVIS recibe la herramienta `send_email` y puede
# avisarte por correo desde tareas proactivas y crons en segundo plano.
# Es la única acción de escritura hacia fuera que no pasa por n8n, así que
# siempre pide APROBAR / DENEGAR en el HUD antes de enviar nada.
# Puerto 587 = STARTTLS (lo habitual). Puerto 465 = SMTPS directo.
# Con Gmail necesitas una «contraseña de aplicación», no la de tu cuenta.
# JARVIS_SMTP_HOST=smtp.gmail.com
# JARVIS_SMTP_PORT=587
# JARVIS_SMTP_USER=tu-cuenta@gmail.com
# JARVIS_SMTP_PASS=
# Remitente. Si se omite, se usa JARVIS_SMTP_USER.
# JARVIS_EMAIL_FROM=
# Destinatario por defecto cuando el agente no especifica uno.
# JARVIS_EMAIL_TO=

# ─── Proxmox VE (telemetría del servidor) ───────────────────────────────────
# El HUD muestra CPU, RAM y disco del nodo. Sin token la API no responde y el
# panel lo dice explícitamente en vez de inventarse cifras.
# Crea el token en Datacenter → Permissions → API Tokens.
# JARVIS_PROXMOX_URL=https://192.168.68.201:8006
# JARVIS_PROXMOX_TOKEN_ID=root@pam!jarvis
# JARVIS_PROXMOX_TOKEN_SECRET=
# Los Proxmox recién instalados traen un certificado autofirmado; ponlo a true
# en cuanto tengas uno de verdad.
# JARVIS_PROXMOX_VERIFY_SSL=false
# Con esto puesto, JARVIS gana las herramientas proxmox_status y proxmox_guests
# y puede responder «¿cómo está el servidor?» o «¿qué VMs tengo encendidas?».
# Sin ellas sabrá igualmente que la capacidad existe y te dirá qué le falta.

# ─── Música (Navidrome) ──────────────────────────────────────────────────────
# Acceso de solo lectura a tu biblioteca. Con esto configurado, JARVIS recibe
# search_music, play_music y control_music, y el HUD muestra el reproductor.
# El audio pasa por el gateway: el navegador nunca ve estas credenciales.
# JARVIS_NAVIDROME_URL=http://192.168.68.159:4533
# JARVIS_NAVIDROME_USERNAME=tu-usuario
# JARVIS_NAVIDROME_PASSWORD=tu-contrasena
# JARVIS_NAVIDROME_TIMEOUT=20

# ─── MQTT (dispositivos ESP32) ───────────────────────────────────────────────
# Desactivado por defecto hasta configurar autenticación/TLS para los HUB físicos.
JARVIS_MQTT_ENABLED=false
JARVIS_MQTT_HOST=localhost
JARVIS_MQTT_PORT=1883
JARVIS_MQTT_TLS=false
JARVIS_MQTT_MAX_PAYLOAD_CHARS=16000
# En producción, usa credenciales y TLS en el broker:
# JARVIS_MQTT_USERNAME=jarvis
# JARVIS_MQTT_PASSWORD=cambia-esto
