# ─────────────────────────────────────────────────────────────────────────────
#  Configuración de JARVIS_OS
#  Copia este fichero a  .env  en la raíz del proyecto y rellena tus valores.
#  NUNCA subas el .env real al repositorio (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Cerebro (elige UN proveedor) ────────────────────────────────────────────
# "anthropic" = Claude (recomendado) · "openai" = compatible (NVIDIA NIM, Ollama…)
JARVIS_LLM_PROVIDER=anthropic

# --- Opción A: Anthropic (Claude) ---
ANTHROPIC_API_KEY=pon-tu-api-key-aqui
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=high

# --- Opción B: NVIDIA NIM (compatible con OpenAI) ---
# Para usar NVIDIA: pon JARVIS_LLM_PROVIDER=openai y descomenta lo siguiente.
# Obtén la API key y el nombre EXACTO del modelo en build.nvidia.com (botón
# "Get API Key" / "View Code"). Ejemplo con GLM-5.2 de Z.ai:
#   https://build.nvidia.com/z-ai/glm-5.2
# JARVIS_LLM_PROVIDER=openai
# JARVIS_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# JARVIS_OPENAI_API_KEY=nvapi-...
# JARVIS_OPENAI_MODEL=z-ai/glm-5.2   # copia el id exacto del ejemplo de código de la página
# Mantén false para que Nemotron no exponga razonamiento interno en el HUD.
JARVIS_OPENAI_ENABLE_THINKING=false

# --- Opción C: Ollama (modelos locales, offline/privacidad) ---
# JARVIS_LLM_PROVIDER=openai
# JARVIS_OPENAI_BASE_URL=http://localhost:11434/v1
# JARVIS_OPENAI_API_KEY=ollama
# JARVIS_OPENAI_MODEL=llama3.1

JARVIS_MAX_TOKENS=16000

# ─── Personalidad ────────────────────────────────────────────────────────────
JARVIS_PERSONA_NAME=JARVIS
JARVIS_LANGUAGE=es
# JARVIS_PERSONA_EXTRA=Trátame de usted. No ejecutes nada destructivo sin confirmar.

# ─── Memoria interna (propia de JARVIS, independiente del proveedor) ──────────
JARVIS_MEMORY_DB=data/jarvis_memory.db

# ─── Herramientas ────────────────────────────────────────────────────────────
JARVIS_ENABLE_SHELL=true
# Lista blanca de comandos permitidos para la herramienta de shell (separados por comas).
JARVIS_SHELL_ALLOWLIST=echo,ls,cat,date,uptime,whoami,hostname,df,free,uname,pwd,ps
JARVIS_MAX_TOOL_ITERATIONS=12
JARVIS_MAX_HISTORY_ITEMS=80

# ─── Gateway (servicio en red) ───────────────────────────────────────────────
# 0.0.0.0 = accesible desde otros equipos de la red local.
JARVIS_GATEWAY_HOST=0.0.0.0
JARVIS_GATEWAY_PORT=8080
# Obligatoria. Genera una clave larga y aleatoria antes de arrancar el gateway.
# REST: cabecera X-Jarvis-Key. WebSocket/HUB: ?token=<clave>.
JARVIS_GATEWAY_API_KEY=
JARVIS_GATEWAY_MAX_MESSAGE_CHARS=16000
JARVIS_GATEWAY_MAX_SESSIONS=100
# Orígenes desde los que se sirve el HUD web (separados por comas).
JARVIS_GATEWAY_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173

# ─── Voz local ───────────────────────────────────────────────────────────────
JARVIS_VOICE_ENABLED=true
# `small` equilibra precisión en español y velocidad para CPU. El primer uso lo descarga.
JARVIS_STT_MODEL=small
JARVIS_STT_DEVICE=cpu
JARVIS_STT_COMPUTE_TYPE=int8
# Docker configura automáticamente las rutas persistentes de modelos y la voz Piper.
# JARVIS_STT_DOWNLOAD_ROOT=/app/data/models
# JARVIS_TTS_MODEL_PATH=/app/voices/es_MX-ald-medium.onnx

# ─── Control agéntico ────────────────────────────────────────────────────────
# Los archivos quedan confinados al volumen /app/workspace; no se expone el host completo.
JARVIS_AGENT_CONTROL_ENABLED=true
JARVIS_WORKSPACE_MAX_FILE_BYTES=262144
# Cada actualización de un archivo existente o instalación pide aprobación en el HUD.
JARVIS_APPROVAL_TIMEOUT_SECONDS=120
JARVIS_PACKAGE_INSTALL_ENABLED=true
# Docker permite pip persistente en /app/.local. Para apt usa el despliegue systemd y
# configura una regla sudo mínima para el usuario jarvis.
JARVIS_PACKAGE_INSTALL_MANAGERS=pip
# Ejecuta únicamente archivos .py del workspace, siempre con aprobación en el HUD.
JARVIS_PYTHON_EXECUTION_ENABLED=true
JARVIS_PYTHON_EXECUTION_TIMEOUT_SECONDS=60

# ─── Internet público de solo lectura ───────────────────────────────────────
JARVIS_INTERNET_ACCESS_ENABLED=true
JARVIS_WEB_REQUEST_TIMEOUT_SECONDS=15
JARVIS_WEB_MAX_DOWNLOAD_BYTES=1048576
# Opcional y recomendado para búsquedas más fiables. Sin clave usa Bing RSS.
# JARVIS_BRAVE_SEARCH_API_KEY=
JARVIS_HUD_WORKSPACE_ENABLED=true

# ─── MQTT (dispositivos ESP32) ───────────────────────────────────────────────
# Desactivado por defecto hasta configurar autenticación/TLS para los HUB físicos.
JARVIS_MQTT_ENABLED=false
JARVIS_MQTT_HOST=localhost
JARVIS_MQTT_PORT=1883
JARVIS_MQTT_TLS=false
JARVIS_MQTT_MAX_PAYLOAD_CHARS=16000
# En producción, usa credenciales y TLS en el broker:
# JARVIS_MQTT_USERNAME=jarvis
# JARVIS_MQTT_PASSWORD=cambia-esto
